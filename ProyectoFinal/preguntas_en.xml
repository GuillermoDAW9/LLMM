<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE test [
  <!ELEMENT test (question+)>
  <!ELEMENT question (wording,choices)>
  <!ELEMENT wording (#PCDATA)>
  <!ELEMENT choices (choice+)>
  <!ELEMENT choice (#PCDATA)>

  <!ATTLIST question id CDATA #REQUIRED>
  <!ATTLIST choice correct (yes|no) 'no'>
]>

<test>

  <question id="1">
    <wording>What does XML stand for?</wording>
    <choices>
      <choice correct="yes">eXtensible Markup Language</choice>
      <choice>Extra Machine Language</choice>
      <choice>Example Markup Language</choice>
      <choice>Extended Modern Language</choice>
    </choices>
  </question>

  <question id="2">
    <wording>What is XML used for?</wording>
    <choices>
      <choice correct="yes">Storing and transporting data</choice>
      <choice>Creating games</choice>
      <choice>Styling websites</choice>
      <choice>Running servers</choice>
    </choices>
  </question>

</test>
